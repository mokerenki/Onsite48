+_SENSITIVE_BASENAMES = {
+    ".env", "credentials.json", "id_rsa", "id_ed25519", ".netrc", ".npmrc", ".pypirc",
+    "secrets.json", "service-account.json",
+}
+
+
+def _is_sensitive_path(path: str) -> bool:
+    """True for secret-looking targets that must never be auto-written."""
+    import posixpath
+
+    norm = posixpath.normpath(path.strip().replace("\\", "/"))
+    base = posixpath.basename(norm).lower()
+    if base in _SENSITIVE_BASENAMES or base.startswith(".env"):
+        return True
+    if base.endswith((".pem", ".key", ".p12", ".pfx")):
+        return True
+    return any(part in (".ssh", ".aws", ".gnupg") for part in norm.split("/"))
+
+
+def _is_workspace_relative(path: str, roots: list[str]) -> bool:
+    """Lexical, backend-agnostic check that ``path`` stays inside the task workspace.
+
+    The workspace backends (DevWorkspace/E2B) resolve relative paths against their own
+    per-run home, so the policy must NOT resolve them against the process working
+    directory. Real confinement (symlinks, `..`) is still enforced by the backend
+    (`DevWorkspace._resolve` raises path_escape); this is only the approval gate.
+    """
+    import posixpath
+
+    raw = path.strip().replace("\\", "/")
+    if not raw or "\x00" in raw or raw.startswith("~"):
+        return False
+    norm = posixpath.normpath(raw)
+    if raw.startswith("/"):
+        return any(norm == r.rstrip("/") or norm.startswith(r.rstrip("/") + "/") for r in roots if r)
+    return norm != ".." and not norm.startswith("../")
+
